{
  "source": "web/src/styles/tokens.css",
  "theme": "Obsidian",
  "tokens": {
    "--bg-app": "#09090b",
    "--bg-sidebar": "#101012",
    "--bg-card": "#151518",
    "--bg-input": "#131316",
    "--bg-sunken": "#1c1c20",
    "--overlay-hover": "rgba(255,255,255,0.06)",
    "--overlay-selected": "rgba(255,255,255,0.10)",
    "--bg-card-hover": "var(--overlay-hover)",
    "--bg-overlay": "rgba(0,0,0,0.65)",
    "--border-subtle": "#232327",
    "--border-base": "#2c2c31",
    "--border-strong": "#494950",
    "--border-focus": "#c4c4ce",
    "--text-primary": "#ededf0",
    "--text-secondary": "#bcbcc5",
    "--text-muted": "#9999a5",
    "--text-inverse": "#111114",
    "--accent-primary": "#ededf0",
    "--accent-primary-hover": "#ffffff",
    "--accent-soft": "var(--overlay-selected)",
    "--accent-glow": "rgba(255,255,255,0.15)",
    "--color-success": "#8fc7a4",
    "--color-success-bg": "#18271f",
    "--color-warning": "#e6bb79",
    "--color-warning-bg": "#2c2419",
    "--color-error": "#ec9292",
    "--color-error-bg": "#301d20",
    "--color-info": "#b7acd9",
    "--color-info-bg": "#242132",
    "--live": "var(--color-warning)",
    "--live-soft": "var(--color-warning-bg)",
    "--chat-user-bg": "#1c2d48",
    "--chat-user-text": "#eef2f8",
    "--folder-back": "#8b8980",
    "--folder-front": "#bbb8ac",
    "--file-document": "var(--text-secondary)",
    "--file-code": "var(--color-info)",
    "--file-data": "var(--color-warning)",
    "--file-image": "var(--color-success)",
    "--radius-sm": "6px",
    "--radius-md": "8px",
    "--radius-lg": "12px",
    "--radius-xl": "16px",
    "--radius-message": "20px",
    "--radius-full": "999px",
    "--shadow-sm": "none",
    "--shadow-md": "0 4px 16px rgba(0,0,0,0.16)",
    "--shadow-lg": "0 16px 48px rgba(0,0,0,0.45)",
    "--font-ui": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "--font-mono": "ui-monospace, 'Cascadia Code', 'SF Mono', Menlo, Consolas, monospace",
    "--text-xs": "0.75rem",
    "--text-sm": "0.8125rem",
    "--text-md": "0.875rem",
    "--text-lg": "1rem",
    "--text-xl": "1.25rem",
    "--text-2xl": "1.5rem",
    "--space-4": "4px",
    "--space-8": "8px",
    "--space-12": "12px",
    "--space-16": "16px",
    "--space-20": "20px",
    "--space-24": "24px",
    "--space-32": "32px",
    "--space-48": "48px",
    "--sidebar-width": "264px",
    "--panel-width": "280px",
    "--nav-height": "40px",
    "--transition-fast": "120ms ease",
    "--transition-normal": "180ms ease"
  }
}
